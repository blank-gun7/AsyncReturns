generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DEVELOPER
  ADVERTISER
  ADMIN
}

enum Region {
  INDIA
  GLOBAL
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXHAUSTED
}

enum PaymentMethod {
  UPI
  PAYPAL
  WISE
  NONE
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
}

enum BlockPurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
}

enum ToolType {
  TERMINAL
  VSCODE
  CURSOR
  OTHER
}

enum TargetRegion {
  INDIA
  GLOBAL
  ALL
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          UserRole  @default(DEVELOPER)
  github_id     String?   @unique
  region        Region    @default(INDIA)
  referral_code String    @unique
  referred_by_id String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  referred_by    User?     @relation("Referrals", fields: [referred_by_id], references: [id])
  referrals      User[]    @relation("Referrals")
  accounts       Account[]
  sessions       Session[]
  wallet         Wallet?
  campaigns      Campaign[]
  impressions    Impression[]
  payouts        Payout[]
  api_keys       ApiKey[]
  referral_earnings_as_referrer ReferralEarning[] @relation("Referrer")
  referral_earnings_as_referred ReferralEarning[] @relation("Referred")

  @@map("users")
}

model Account {
  id                  String  @id @default(cuid())
  user_id             String
  type                String
  provider            String
  provider_account_id String
  access_token        String?
  refresh_token       String?
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@map("accounts")
}

model Session {
  id            String   @id @default(cuid())
  session_token String   @unique
  user_id       String
  expires       DateTime

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Wallet {
  id                  String        @id @default(cuid())
  user_id             String        @unique
  balance_usd         Decimal       @default(0) @db.Decimal(10, 4)
  lifetime_earned_usd Decimal       @default(0) @db.Decimal(10, 4)
  pending_usd         Decimal       @default(0) @db.Decimal(10, 4)
  payment_method      PaymentMethod @default(NONE)
  payment_details     Json?
  updated_at          DateTime      @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Campaign {
  id                    String         @id @default(cuid())
  advertiser_id         String
  name                  String
  ad_text               String
  ad_icon               String
  ad_color              String
  ad_url                String
  target_region         TargetRegion   @default(INDIA)
  priority              Int            @default(0)
  status                CampaignStatus @default(DRAFT)
  blocks_purchased      Int            @default(0)
  impressions_remaining Int            @default(0)
  impressions_delivered Int            @default(0)
  clicks                Int            @default(0)
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt

  advertiser      User              @relation(fields: [advertiser_id], references: [id])
  block_purchases BlockPurchase[]
  impressions     Impression[]

  @@index([status, priority(sort: Desc)])
  @@map("campaigns")
}

model BlockPurchase {
  id                  String              @id @default(cuid())
  campaign_id         String
  advertiser_id       String
  blocks              Int
  price_per_block_usd Decimal             @db.Decimal(10, 4)
  total_usd           Decimal             @db.Decimal(10, 4)
  payment_provider    PaymentProvider
  payment_id          String?
  status              BlockPurchaseStatus @default(PENDING)
  created_at          DateTime            @default(now())

  campaign Campaign @relation(fields: [campaign_id], references: [id])

  @@map("block_purchases")
}

model Impression {
  id              String   @id @default(cuid())
  campaign_id     String
  developer_id    String
  cli_session_id  String
  duration_ms     Int
  ip_hash         String
  tool_type       ToolType @default(OTHER)
  clicked         Boolean  @default(false)
  valid           Boolean  @default(true)
  created_at      DateTime @default(now())

  campaign         Campaign          @relation(fields: [campaign_id], references: [id])
  developer        User              @relation(fields: [developer_id], references: [id])
  referral_earning ReferralEarning?

  @@index([campaign_id, created_at])
  @@index([developer_id, created_at])
  @@map("impressions")
}

model Payout {
  id           String       @id @default(cuid())
  developer_id String
  amount_usd   Decimal      @db.Decimal(10, 4)
  amount_local Decimal      @db.Decimal(10, 4)
  currency     String
  method       PaymentMethod
  status       PayoutStatus @default(REQUESTED)
  payment_ref  String?
  requested_at DateTime     @default(now())
  processed_at DateTime?

  developer User @relation(fields: [developer_id], references: [id])

  @@index([developer_id, status])
  @@map("payouts")
}

model ReferralEarning {
  id            String   @id @default(cuid())
  referrer_id   String
  referred_id   String
  impression_id String   @unique
  amount_usd    Decimal  @db.Decimal(10, 6)
  created_at    DateTime @default(now())

  referrer   User       @relation("Referrer", fields: [referrer_id], references: [id])
  referred   User       @relation("Referred", fields: [referred_id], references: [id])
  impression Impression @relation(fields: [impression_id], references: [id])

  @@map("referral_earnings")
}

model ApiKey {
  id           String    @id @default(cuid())
  user_id      String
  key_hash     String    @unique
  key_prefix   String
  name         String    @default("CLI")
  last_used_at DateTime?
  expires_at   DateTime?
  created_at   DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([key_hash])
  @@map("api_keys")
}
